<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property resource="application.properties"/>
    <contextName>${spring.application.name}</contextName>

    <!--
      Два назначения логов: stdout контейнера и JSON-файл на общем volume для Filebeat.
      traceId/spanId кладутся в MDC автоматически Micrometer Tracing (Brave),
      uri/httpMethod — RequestTracingFilter; здесь они выведены явными полями.
    -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <pattern>
                    <pattern>
                        {
                        "traceId": "%X{traceId:-}",
                        "spanId": "%X{spanId:-}",
                        "uri": "%X{uri:-}",
                        "httpMethod": "%X{httpMethod:-}"
                        }
                    </pattern>
                </pattern>
                <timestamp>
                    <fieldName>ts</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <mdc/>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <stackTrace>
                    <fieldName>stack</fieldName>
                </stackTrace>
                <contextName>
                    <fieldName>app</fieldName>
                </contextName>
            </providers>
        </encoder>
    </appender>

    <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/var/log/etl/batch-processing.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>/var/log/etl/batch-processing.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <pattern>
                    <pattern>
                        {
                        "traceId": "%X{traceId:-}",
                        "spanId": "%X{spanId:-}",
                        "uri": "%X{uri:-}",
                        "httpMethod": "%X{httpMethod:-}"
                        }
                    </pattern>
                </pattern>
                <timestamp>
                    <fieldName>ts</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>msg</fieldName>
                </message>
                <mdc/>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <stackTrace>
                    <fieldName>stack</fieldName>
                </stackTrace>
                <contextName>
                    <fieldName>app</fieldName>
                </contextName>
            </providers>
        </encoder>
    </appender>

    <logger name="com.example.batchprocessing" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE_JSON"/>
    </root>
</configuration>
