@startuml c2-diagram-tobe
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Генерация B2B прайс-листов — To Be

System_Boundary(k8s, "k8s") {
    ContainerDb(pricelist_db, "БД прайс-листов", "PostgreSQL", "Актуальные данные о ценах: products, categories, clients, client_prices")
}

Component(pricelist_job, "Задача генерации прайс-листов", "K8s CronJob", "Ежедневно в 6:00 делает запрос products/categories/clients/client_prices и формирует CSV/XLS")
ContainerDb(file_storage, "Хранилище прайс-листов", "Object Storage (S3/GCS-совместимое)", "Готовые CSV/XLS файлы для B2B-клиентов")

Rel(pricelist_db, pricelist_job, "Данные о ценах и остатках", "SQL / JDBC")
Rel(pricelist_job, file_storage, "Готовые прайс-листы", "ежедневно, 0 6 * * *")

@enduml