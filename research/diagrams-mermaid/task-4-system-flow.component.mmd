---
config:
  theme: base
  themeCSS: |
    text, tspan, .label, .label *, .nodeLabel, .nodeLabel *, .classTitle, .classText, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, foreignObject * {
      color: #000000 !important;
      fill: #000000 !important;
      opacity: 1 !important;
    }
    .label, .nodeLabel, .edgeLabel, .cluster-label {
      font-weight: 500 !important;
    }
    .classTitle {
      font-weight: 700 !important;
    }
    .relation, .flowchart-link {
      stroke: #111827 !important;
      opacity: 1 !important;
    }
  themeVariables:
    darkMode: false
    background: "#ffffff"
    primaryColor: "#f8fafc"
    primaryTextColor: "#000000"
    primaryBorderColor: "#1f2937"
    secondaryColor: "#eef6ff"
    secondaryTextColor: "#000000"
    secondaryBorderColor: "#374151"
    tertiaryColor: "#ffffff"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#4b5563"
    lineColor: "#111827"
    textColor: "#000000"
    mainBkg: "#f8fafc"
    secondBkg: "#eef2ff"
    classText: "#000000"
    nodeBorder: "#1f2937"
    clusterBkg: "#ffffff"
    clusterBorder: "#4b5563"
    edgeLabelBackground: "#ffffff"
    titleColor: "#000000"
---
flowchart LR
  subgraph canvas["Task 4. Компоненты Spring Batch ETL"]
  direction LR
  operator(["Разработчик /<br/>оператор"]):::actor

  subgraph host["Локальный компьютер"]
    direction TB
    build["Gradle / Docker build"]:::component
    image["batch-processing<br/>контейнерный образ"]:::component

    subgraph compose["Docker Compose network"]
      direction LR

      subgraph appContainer["app — Spring Boot container"]
        direction TB
        app["BatchProcessingApplication"]:::component
        job["Spring Batch<br/>importProductJob"]:::component
        reader["FlatFileItemReader"]:::component
        processor["ProductItemProcessor"]:::component
        writer["JdbcBatchItemWriter"]:::component
        listener["JobCompletion-<br/>NotificationListener"]:::component
        productCsv["product-data.csv"]:::file
      end

      postgres[("postgres<br/>PostgreSQL :5432")]:::database
      databaseInit["schema-all.sql +<br/>loyality_data.csv"]:::file
      postgresVolume[("products-db-data")]:::storage
    end
  end

  operator -->|docker compose build app| build
  build -->|создаёт JAR и образ| image
  operator -->|docker compose run app| app
  image -->|запускает контейнер| app

  app -->|старт с новым run.id| job
  job -->|read| reader
  reader -->|строки Product| productCsv
  job -->|"process(Product)"| processor
  processor -->|"загрузка loyalty<br/>по product_sku"| postgres
  job -->|chunk до 500 записей| writer
  writer -->|batch UPSERT products| postgres
  job -->|afterJob| listener
  listener -->|"COUNT(products)"| postgres

  databaseInit -->|схема + справочник| postgres
  postgres -->|"products, loyalty,<br/>BATCH_* metadata"| postgresVolume
  job -->|Job Repository| postgres
  operator -->|проверочный SELECT| postgres

  build -.-> buildNote["<b>task-4/results/Dockerfile</b><br/>Gradle/JDK → JRE-образ,<br/>запуск не от root."]:::note
  job -.-> jobNote["<b>BatchConfiguration</b><br/>chunk-size: 500<br/>retry: до 3 попыток"]:::note
  writer -.-> writerNote["<b>task-4-java-class-diagram.class.mmd</b><br/>показывает структуру Java-кода."]:::note
  end

  classDef actor fill:#fff2cc,stroke:#d6b656,color:#000;
  classDef component fill:#e1f5fe,stroke:#0288d1,color:#000;
  classDef database fill:#e8f5e9,stroke:#388e3c,color:#000;
  classDef storage fill:#f3e5f5,stroke:#7b1fa2,color:#000;
  classDef file fill:#fce4ec,stroke:#c2185b,color:#000;
  classDef note fill:#fffde7,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 3;
  style canvas fill:#ffffff,stroke:#ffffff,color:#0f172a
  style host fill:#fafafa,stroke:#616161
  style compose fill:#f5f5f5,stroke:#616161
  style appContainer fill:#ffffff,stroke:#1976d2
