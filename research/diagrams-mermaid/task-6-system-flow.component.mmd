---
config:
  theme: base
  themeCSS: |
    text, tspan, .label, .label *, .nodeLabel, .nodeLabel *, .classTitle, .classText, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, foreignObject * {
      color: #000000 !important;
      fill: #000000 !important;
      opacity: 1 !important;
    }
    .label, .nodeLabel, .edgeLabel, .cluster-label {
      font-weight: 500 !important;
    }
    .classTitle {
      font-weight: 700 !important;
    }
    .relation, .flowchart-link {
      stroke: #111827 !important;
      opacity: 1 !important;
    }
  themeVariables:
    darkMode: false
    background: "#ffffff"
    primaryColor: "#f8fafc"
    primaryTextColor: "#000000"
    primaryBorderColor: "#1f2937"
    secondaryColor: "#eef6ff"
    secondaryTextColor: "#000000"
    secondaryBorderColor: "#374151"
    tertiaryColor: "#ffffff"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#4b5563"
    lineColor: "#111827"
    textColor: "#000000"
    mainBkg: "#f8fafc"
    secondBkg: "#eef2ff"
    classText: "#000000"
    nodeBorder: "#1f2937"
    clusterBkg: "#ffffff"
    clusterBorder: "#4b5563"
    edgeLabelBackground: "#ffffff"
    titleColor: "#000000"
---
flowchart LR
  subgraph canvas["Task 6. Запуск Spring Batch по API и доставка trace-контекста"]
  direction LR

  client["Java client<br/>BatchJobClient"]:::component

  subgraph compose["Docker Compose network"]
    direction LR

    subgraph application["app — Spring Boot"]
      direction TB
      observation["Spring MVC Observation<br/>Micrometer Tracing + Brave"]:::component
      filter["HttpTraceLoggingFilter"]:::component
      controller["JobLaunchController<br/>POST /api/v1/jobs/import-products"]:::component
      launcher["JobLauncher"]:::component
      job["importProductJob<br/>Reader → Processor → Writer"]:::component
      jsonLogs["Logback JSON + MDC"]:::component
    end

    postgres[("PostgreSQL<br/>products + BATCH_*")]:::database
    filebeat["Filebeat"]:::component
    logstash["Logstash"]:::component
    elasticsearch[("Elasticsearch<br/>batch-processing-*")]:::database
    kibana["Kibana Discover"]:::component
  end

  client -->|"POST + W3C traceparent"| observation
  observation -->|создаёт server span| filter
  filter --> controller
  controller -->|уникальный requestId| launcher
  launcher --> job
  job -->|JDBC| postgres
  job -->|JOB_* и STEP_*| jsonLogs
  filter -->|HTTP_REQUEST + uri| jsonLogs
  controller -->|"status + traceId"| client

  jsonLogs -->|Docker stdout| filebeat
  filebeat -->|Beats| logstash
  logstash -->|index| elasticsearch
  kibana -->|поиск по traceId| elasticsearch

  observation -.-> tracingNote["<b>application.properties</b><br/>sampling=1.0, propagation=w3c"]:::note
  filter -.-> filterNote["<b>HttpTraceLoggingFilter</b><br/>логирует только /api/*"]:::note
  jsonLogs -.-> logNote["<b>logback-spring.xml</b><br/>MDC → traceId и spanId"]:::note
  filebeat -.-> deliveryNote["<b>filebeat.yml + logstash.conf</b><br/>доставка не связана с Job-транзакцией"]:::note
  end

  classDef component fill:#e1f5fe,stroke:#0288d1,color:#000;
  classDef database fill:#e8f5e9,stroke:#388e3c,color:#000;
  classDef note fill:#fffde7,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 3;
  style canvas fill:#ffffff,stroke:#ffffff,color:#0f172a
  style compose fill:#f5f5f5,stroke:#616161
  style application fill:#ffffff,stroke:#1976d2
