---
config:
  theme: base
  themeCSS: |
    text, tspan, .label, .label *, .nodeLabel, .nodeLabel *, .classTitle, .classText, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, foreignObject * {
      color: #000000 !important;
      fill: #000000 !important;
      opacity: 1 !important;
    }
    .label, .nodeLabel, .edgeLabel, .cluster-label {
      font-weight: 500 !important;
    }
    .classTitle {
      font-weight: 700 !important;
    }
    .relation, .flowchart-link {
      stroke: #111827 !important;
      opacity: 1 !important;
    }
  themeVariables:
    darkMode: false
    background: "#ffffff"
    primaryColor: "#f8fafc"
    primaryTextColor: "#000000"
    primaryBorderColor: "#1f2937"
    secondaryColor: "#eef6ff"
    secondaryTextColor: "#000000"
    secondaryBorderColor: "#374151"
    tertiaryColor: "#ffffff"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#4b5563"
    lineColor: "#111827"
    textColor: "#000000"
    mainBkg: "#f8fafc"
    secondBkg: "#eef2ff"
    classText: "#000000"
    nodeBorder: "#1f2937"
    clusterBkg: "#ffffff"
    clusterBorder: "#4b5563"
    edgeLabelBackground: "#ffffff"
    titleColor: "#000000"
---
flowchart LR
  subgraph canvas["Task 5. Компоненты потоков метрик и централизованных логов"]
  direction LR
  operator(["Разработчик /<br/>поддержка"]):::actor

  subgraph compose["Docker Compose network"]
    direction LR

    subgraph applicationGroup["Application"]
      direction TB
      job["Spring Batch<br/>importProductJob"]:::component
      metrics["Micrometer + Actuator<br/>/actuator/prometheus"]:::component
      logging["Logback JSON<br/>batch events"]:::component
      postgres[("PostgreSQL<br/>products + BATCH_*")]:::database
    end

    subgraph monitoringGroup["Monitoring pipeline"]
      direction TB
      prometheus["Prometheus<br/>scrape every 5s"]:::component
      grafana["Grafana<br/>dashboard"]:::component
      alerts["Grafana alert rules"]:::component
    end

    subgraph loggingGroup["Logging pipeline"]
      direction TB
      filebeat["Filebeat"]:::component
      logstash["Logstash<br/>validation + enrichment"]:::component
      elasticsearch[("Elasticsearch<br/>batch-processing-*")]:::database
      kibana["Kibana<br/>log discovery"]:::component
    end
  end

  dockerLogs["Docker stdout<br/>container logs"]:::storage

  job -->|read / batch UPSERT| postgres
  job -->|"Job/Step counters,<br/>duration and status"| metrics
  job -->|JOB_* and STEP_* events| logging

  prometheus -->|HTTP scrape| metrics
  grafana -->|PromQL| prometheus
  alerts -->|evaluate rules| prometheus
  alerts -->|Pending / Firing| operator
  operator -->|dashboards| grafana

  logging -->|JSON stdout| dockerLogs
  dockerLogs -->|app container only| filebeat
  filebeat -->|Beats protocol| logstash
  logstash -->|bulk index| elasticsearch
  kibana -->|search| elasticsearch
  operator -->|investigate Job / errors| kibana

  metrics -.-> metricsNote["<b>application.properties</b><br/>открывает Prometheus endpoint."]:::note
  logging -.-> loggingNote["<b>logback-spring.xml</b><br/>добавляет status, counters,<br/>durationMs и идентификаторы Job."]:::note
  alerts -.-> alertsNote["JOB_FAILED или<br/>duration &gt; 30 секунд."]:::note
  logstash -.-> logstashNote["Недоступность ELK не останавливает<br/>выполнение Spring Batch."]:::note
  end

  classDef actor fill:#fff2cc,stroke:#d6b656,color:#000;
  classDef component fill:#e1f5fe,stroke:#0288d1,color:#000;
  classDef database fill:#e8f5e9,stroke:#388e3c,color:#000;
  classDef storage fill:#f3e5f5,stroke:#7b1fa2,color:#000;
  classDef note fill:#fffde7,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 3;
  style canvas fill:#ffffff,stroke:#ffffff,color:#0f172a
  style compose fill:#f5f5f5,stroke:#616161
  style applicationGroup fill:#ffffff,stroke:#1976d2
  style monitoringGroup fill:#ffffff,stroke:#2e7d32
  style loggingGroup fill:#ffffff,stroke:#6a1b9a
