---
config:
  theme: base
  themeCSS: |
    text, tspan, .label, .label *, .nodeLabel, .nodeLabel *, .classTitle, .classText, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, foreignObject * {
      color: #000000 !important;
      fill: #000000 !important;
      opacity: 1 !important;
    }
    .label, .nodeLabel, .edgeLabel, .cluster-label {
      font-weight: 500 !important;
    }
    .classTitle {
      font-weight: 700 !important;
    }
    .relation, .flowchart-link {
      stroke: #111827 !important;
      opacity: 1 !important;
    }
  themeVariables:
    darkMode: false
    background: "#ffffff"
    primaryColor: "#f8fafc"
    primaryTextColor: "#000000"
    primaryBorderColor: "#1f2937"
    secondaryColor: "#eef6ff"
    secondaryTextColor: "#000000"
    secondaryBorderColor: "#374151"
    tertiaryColor: "#ffffff"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#4b5563"
    lineColor: "#111827"
    textColor: "#000000"
    mainBkg: "#f8fafc"
    secondBkg: "#eef2ff"
    classText: "#000000"
    nodeBorder: "#1f2937"
    clusterBkg: "#ffffff"
    clusterBorder: "#4b5563"
    edgeLabelBackground: "#ffffff"
    titleColor: "#000000"
---
flowchart LR
  subgraph canvas["Task 5. Развёртывание monitoring и logging в Docker Compose"]
  direction LR
  operator(["Разработчик / поддержка"]):::actor

  subgraph host["Локальный компьютер"]
    direction TB

    subgraph compose["Docker Compose network"]
      direction LR

      subgraph applicationGroup["Application"]
        direction TB
        app["app<br/>Spring Boot + Spring Batch<br/>:8080"]:::component
        postgres[("postgres<br/>PostgreSQL :5432")]:::database
      end

      subgraph monitoringGroup["Monitoring"]
        direction TB
        prometheus["prometheus<br/>:9090"]:::component
        grafana["grafana<br/>:3000"]:::component
      end

      subgraph loggingGroup["Centralized logging"]
        direction TB
        filebeat["filebeat"]:::component
        logstash["logstash<br/>Beats :5044"]:::component
        elasticsearch[("elasticsearch<br/>HTTP :9200")]:::database
        kibana["kibana<br/>:5601"]:::component
      end
    end

    dockerLogs["Docker container logs<br/>/var/lib/docker/containers"]:::storage
    postgresVolume[("products-db-data")]:::storage
    elasticsearchVolume[("elasticsearch-data")]:::storage
  end

  app -->|JDBC| postgres
  postgres -->|products и BATCH_*| postgresVolume

  prometheus -->|"scrape<br/>/actuator/prometheus"| app
  grafana -->|PromQL| prometheus

  app -->|JSON stdout| dockerLogs
  dockerLogs -->|read-only| filebeat
  filebeat -->|Beats| logstash
  logstash -->|HTTP / bulk index| elasticsearch
  elasticsearch -->|индексы логов| elasticsearchVolume
  kibana -->|search| elasticsearch

  operator -->|"dashboard и alerts<br/>http://localhost:3000"| grafana
  operator -->|"проверка targets<br/>http://localhost:9090"| prometheus
  operator -->|"поиск логов<br/>http://localhost:5601"| kibana

  app -.-> appNote["<b>application.properties</b><br/>Actuator endpoint и настройки БД<br/><br/><b>logback-spring.xml</b><br/>JSON-поля batch-событий"]:::note
  prometheus -.-> prometheusNote["<b>prometheus/prometheus.yml</b><br/>target: app:8080"]:::note
  grafana -.-> grafanaNote["<b>grafana/provisioning/</b><br/>datasource, dashboard, alert rules"]:::note
  filebeat -.-> filebeatNote["<b>filebeat/filebeat.yml</b><br/>доступ к Docker logs и socket,<br/>фильтр контейнера app"]:::note
  logstash -.-> logstashNote["<b>logstash/pipeline/logstash.conf</b><br/>Beats input, JSON processing,<br/>Elasticsearch output"]:::note
  end

  classDef actor fill:#fff2cc,stroke:#d6b656,color:#000;
  classDef component fill:#e1f5fe,stroke:#0288d1,color:#000;
  classDef database fill:#e8f5e9,stroke:#388e3c,color:#000;
  classDef storage fill:#f3e5f5,stroke:#7b1fa2,color:#000;
  classDef note fill:#fffde7,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 3;
  style canvas fill:#ffffff,stroke:#ffffff,color:#0f172a
  style host fill:#fafafa,stroke:#616161
  style compose fill:#f5f5f5,stroke:#616161
  style applicationGroup fill:#ffffff,stroke:#1976d2
  style monitoringGroup fill:#ffffff,stroke:#2e7d32
  style loggingGroup fill:#ffffff,stroke:#6a1b9a
