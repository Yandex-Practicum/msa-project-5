---
config:
  theme: base
  themeCSS: |
    text, tspan, .label, .label *, .nodeLabel, .nodeLabel *, .classTitle, .classText, .edgeLabel, .edgeLabel *, .cluster-label, .cluster-label *, foreignObject * {
      color: #000000 !important;
      fill: #000000 !important;
      opacity: 1 !important;
    }
    .label, .nodeLabel, .edgeLabel, .cluster-label {
      font-weight: 500 !important;
    }
    .classTitle {
      font-weight: 700 !important;
    }
    .relation, .flowchart-link {
      stroke: #111827 !important;
      opacity: 1 !important;
    }
  themeVariables:
    darkMode: false
    background: "#ffffff"
    primaryColor: "#f8fafc"
    primaryTextColor: "#000000"
    primaryBorderColor: "#1f2937"
    secondaryColor: "#eef6ff"
    secondaryTextColor: "#000000"
    secondaryBorderColor: "#374151"
    tertiaryColor: "#ffffff"
    tertiaryTextColor: "#000000"
    tertiaryBorderColor: "#4b5563"
    lineColor: "#111827"
    textColor: "#000000"
    mainBkg: "#f8fafc"
    secondBkg: "#eef2ff"
    classText: "#000000"
    nodeBorder: "#1f2937"
    clusterBkg: "#ffffff"
    clusterBorder: "#4b5563"
    edgeLabelBackground: "#ffffff"
    titleColor: "#000000"
---
flowchart LR
  subgraph canvas["Task 3. Компоненты экспорта данных в Kubernetes"]
  direction LR
  operator(["Разработчик /<br/>оператор"]):::actor

  subgraph workstation["Рабочая станция"]
    direction TB
    build["Docker build<br/>Maven + JDK"]:::component
    localImage["shipment-exporter:local<br/>контейнерный образ"]:::component
    cli["kubectl / minikube CLI"]:::component
  end

  subgraph minikube["Minikube"]
    direction TB
    imageStore["Хранилище образов<br/>Minikube"]:::component

    subgraph cluster["Kubernetes cluster"]
      direction TB
      cronjob["CronJob<br/>shipment-exporter<br/>0 20 * * *"]:::component
      exporter["Job / Pod<br/>Java exporter"]:::component
      inspector["output-inspector<br/>Pod"]:::component
      config["ConfigMap<br/>настройки экспорта"]:::component
      secret["Secret<br/>DB_PASSWORD"]:::component
      dbService["Service<br/>shipment-db:5432"]:::component
      postgres[("PostgreSQL<br/>shipments")]:::database
      databasePvc[("PVC<br/>shipment-db-data")]:::storage
      exportPvc["PVC<br/>shipment-export-data"]:::storage
    end
  end

  operator -->|docker build| build
  build -->|создаёт| localImage
  operator -->|deploy / inspect| cli
  localImage -->|minikube image load| imageStore

  cli -->|kubectl apply| cronjob
  cronjob -->|создаёт по расписанию| exporter
  imageStore -->|образ app.jar| exporter
  config -->|envFrom| exporter
  secret -->|envFrom| exporter

  exporter -->|"JDBC SELECT<br/>за текущую дату"| dbService
  dbService --> postgres
  postgres -->|данные БД| databasePvc
  exporter -->|".csv.part →<br/>shipments-YYYY-MM-DD.csv"| exportPvc

  cli -->|kubectl apply / exec| inspector
  inspector -->|read-only проверка CSV| exportPvc

  build -.-> buildNote["<b>task-3/results/Dockerfile</b><br/>Multi-stage build:<br/>Maven/JDK → компактный JRE"]:::note
  cronjob -.-> cronNote["<b>k8s/cronjob.yaml</b><br/>timeZone: Europe/Moscow<br/>concurrencyPolicy: Forbid"]:::note
  exporter -.-> exporterNote["<b>ExportSettings</b> читает env.<br/><b>ShipmentCsvExporter</b> получает ResultSet<br/>порциями DB_FETCH_SIZE."]:::note
  exportPvc -.-> pvcNote["<b>task-3-java-class-diagram.class.mmd</b><br/>показывает структуру Java-кода."]:::note
  end

  classDef actor fill:#fff2cc,stroke:#d6b656,color:#000;
  classDef component fill:#e1f5fe,stroke:#0288d1,color:#000;
  classDef database fill:#e8f5e9,stroke:#388e3c,color:#000;
  classDef storage fill:#f3e5f5,stroke:#7b1fa2,color:#000;
  classDef note fill:#fffde7,stroke:#9e9e9e,color:#000,stroke-dasharray: 4 3;
  style canvas fill:#ffffff,stroke:#ffffff,color:#0f172a
  style workstation fill:#fafafa,stroke:#616161
  style minikube fill:#f5f5f5,stroke:#616161
  style cluster fill:#ffffff,stroke:#1976d2
