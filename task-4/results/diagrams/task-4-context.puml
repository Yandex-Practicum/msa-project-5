System_Ext(gcs, "Google Cloud Storage", "Хранит исходные и обработанные CSV-файлы")
SystemDb_Ext(productDb, "БД номенклатуры", "PostgreSQL: хранит данные лояльности и обновлённые товары")

Rel(employee, erp, "Загружает CSV и смотрит статус", "HTTPS")
Rel(erp, gcs, "Сохраняет проверенный CSV")
Rel(erp, etl, "Запускает Job по fileId и получает статус", "HTTPS / event")
Rel(etl, gcs, "Читает CSV и обновляет его статус", "GCS API")
Rel(etl, productDb, "Читает loyality_data и записывает products", "JDBC")

@enduml
