@startuml
!include <C4/C4_Context>

title Task 4.1. C4 System Context — ETL обработки отчётов

LAYOUT_LEFT_RIGHT()

Person(employee, "Сотрудник склада", "Загружает товарный отчёт и получает результат обработки")

System_Ext(erp, "ERP / монолит TradeWare", "Проверяет загрузку, сохраняет файл и показывает статус")
