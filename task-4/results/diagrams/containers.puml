@startuml
title TradeWare — контейнеры целевой системы (C4, уровень 2)
left to right direction
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam componentStyle rectangle
skinparam packageStyle rectangle
actor "Сотрудник склада" as employee
actor "Оператор поддержки" as operator
rectangle "Партнёры и склады\n[Внешняя система]" as partners #DDDDDD
package "TradeWare [Граница системы]" {
  rectangle "ERP-интерфейс\n[Контейнер: Angular]\nЗагрузка и статус" as ui #85BBF0
  rectangle "Монолит ERP\n[Контейнер: Java, WildFly]\nAPI, регистрация задания, статусы" as monolith #85BBF0
  queue "Очередь заданий\n[Контейнер: например, Pub/Sub]\nДоставка идентификатора файла" as queue #85BBF0
  rectangle "Обработка отчётов\n[Контейнер: Java, Spring Batch]\nПроверка, обогащение, пакетная запись" as batch #85BBF0
  database "Хранилище отчётов\n[Контейнер: GCS]\nВерсии CSV" as storage #85BBF0
  database "Справочник\n[Контейнер: PostgreSQL]\nТовары и лояльность" as ref #85BBF0
  database "БД товаров и заданий\n[Контейнер: PostgreSQL]\nРезультаты и метаданные Batch" as db #85BBF0
  rectangle "Наблюдаемость\n[Контейнер: Cloud Logging и Monitoring]\nЛоги, метрики, оповещения" as obs #85BBF0
}
employee --> ui : Загружает CSV,\nпроверяет статус
ui --> monolith : API [HTTPS]
partners --> monolith : Получают данные [HTTPS]
monolith --> storage : Сохраняет файл [GCS API]
monolith --> db : Регистрация и статус [SQL]
monolith --> queue : Публикует через outbox
queue --> batch : Доставляет задание
batch --> storage : Читает версию CSV [GCS API]
batch --> ref : Читает данные [SQL]
batch --> db : Пишет результат и статус [SQL]
batch --> obs : Логи и метрики
monolith --> obs : Логи и метрики
operator --> obs : Контролирует ошибки\nи задержки
@enduml
